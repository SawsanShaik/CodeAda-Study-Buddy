{
  "manifest_version": 3,
  "name": "StudyBuddy",
  "version": "1.3",
  "description": "Your study mascot follows you to every tab: it pops up when you get distracted and blocks distracting sites during focus sessions.",
  "permissions": ["storage", "notifications", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
