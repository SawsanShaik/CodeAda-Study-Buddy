{
  "manifest_version": 3,
  "name": "StudyBuddy",
  "version": "1.5",
  "description": "Your pixel dog study buddy follows you to every tab: it naps while you focus, nudges you when you get distracted, blocks distracting sites during focus sessions, and keeps your Canvas due dates handy.",
  "permissions": ["storage", "notifications", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dog.js", "site-blocker.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dog-overlay.js", "pixelDog.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
