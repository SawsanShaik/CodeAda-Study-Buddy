{
  "manifest_version": 3,
  "name": "Study Buddy Character (dev)",
  "version": "0.1.0",
  "description": "Dev build of the pixel dog overlay. Use the popup to send it test messages.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Study Buddy character tester",
    "default_popup": "dev-popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.js", "pixelDog.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
